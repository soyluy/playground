Get the matching gym members
	SELECT * FROM get_fit_now_member AS g
	LEFT JOIN person AS p ON g.person_id = p.id
	LEFT JOIN drivers_license AS dl ON p.license_id = dl.id
	LEFT JOIN get_fit_now_check_in AS gci ON g.id = gci.membership_id
	WHERE g.id LIKE "48Z%" AND dl.plate_number LIKE "%H42W%"
	;
