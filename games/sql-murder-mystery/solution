Get the matching concert attendees
	SELECT p.name, COUNT(*) AS cnt from drivers_license AS dl
LEFT JOIN person AS p ON p.license_id = dl.id
LEFT JOIN facebook_event_checkin AS fec on p.id = fec.person_id
WHERE 
	dl.height >= 65 
	AND dl.height <= 67
	AND dl.hair_color = "red"
	AND dl.car_make = "Tesla"
	AND dl.gender = "female"
	AND dl.car_model = "Model S"
	AND fec.event_name = "SQL Symphony Concert"
	GROUP BY p.id
	HAVING cnt >= 3
	;
