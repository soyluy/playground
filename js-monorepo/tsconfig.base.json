{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@hub/todo-ui": ["libs/todo/ui/src/index.ts"],
      "@hub/todo-api": ["libs/todo/api/src/index.ts"],
      "@hub/todo-data": ["libs/todo/data/src/index.ts"],
      "@hub/prisma": ["libs/prisma/src/index.ts"]
    },
    "sourceMap": true
  }
}
